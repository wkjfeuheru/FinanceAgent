# Compose 内部会覆盖主机名；这里只列出需要人工填写或可能改的项。
# 复制为 .env 后使用：cp .env.example .env

# ── 必填 ──────────────────────────────────────────────
DEEPSEEK_API_KEY=
POSTGRES_PASSWORD=
# 意图分类主模型（README 默认 qwen-turbo）。同源反代时也可沿用 DeepSeek 回退链。
INTENT_MODEL_API_KEY=

# ── 运行环境 ──────────────────────────────────────────
# production 时关闭 /docs 与 OpenAPI，并收紧管理员口令。
APP_ENV=production
# 浏览器跨域来源（逗号分隔）。经本仓库 Nginx 同源反代时留空即可。
CORS_ALLOW_ORIGINS=
# API 在反代之后必须开启，登录限流才信任 X-Forwarded-For。
TRUST_PROXY=true

# ── PostgreSQL（compose 会把 HOST 指到 postgres 服务）──
POSTGRES_USER=postgres
POSTGRES_DB=advisor
POSTGRES_PORT=5432

# ── 可选调参（默认值即可用）─────────────────────────────
# 领域决策模式：llm（默认，LLM Supervisor 选域）/ legacy（确定性 scope_tasks）。
# legacy 是临时急停回退，观察期结束后会移除。
# ORCHESTRATION_SUPERVISOR_MODE=llm
# 板块/概念筛选：每轮最多评估多少只板块成分、最终返回多少只候选。
# 每只候选要逐只取数（约 5 次数据源调用），调大容易撞上整轮执行上限。
# ORCHESTRATION_SCREEN_MAX_EVALUATIONS=10
# ORCHESTRATION_SCREEN_MAX_RESULTS=5

# 板块（概念/行业）取数主机与预算。东财板块接口只挂在 *.push2.eastmoney.com，
# 该域名在部分网络环境会连续数分钟 502/断连；这里可换成可达镜像。
# EM_BOARD_BASE_URLS=https://17.push2.eastmoney.com,https://push2.eastmoney.com,https://79.push2.eastmoney.com
# 单请求超时（秒）/ 单个板块类型总预算（秒，须显著小于 DATA_PROVIDER_TIMEOUT）/ 翻页上限（每页 100 行）
# EM_BOARD_TIMEOUT=4
# EM_BOARD_DEADLINE=10
# EM_BOARD_MAX_PAGES=8

# ── 管理员引导（bootstrap_admin.py 可读取）────────────
# FINANCE_ADMIN_PASSWORD=
